<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="82dp"
    android:padding="8dp">

    <RelativeLayout
        android:id="@+id/itemRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/card_light_grey"
        android:padding="12dp">

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Workout Title"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/allerta_stencil"/>

        <TextView
            android:id="@+id/textSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textTitle"
            android:layout_marginTop="4dp"
            android:text="Primary • Equipment • Difficulty"
            android:textColor="@color/dark_blue2"
            android:textSize="12sp"
            android:fontFamily="@font/allerta_stencil"/>
    </RelativeLayout>

    <!-- Disabled overlay shown while this item is pending -->
    <View
        android:id="@+id/viewDisabledOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"/>
</FrameLayout>
