<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:padding="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_light_grey"
        android:padding="14dp">

        <TextView
            android:id="@+id/textWorkoutTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Workout title"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/allerta_stencil" />

        <TextView
            android:id="@+id/textWorkoutSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textWorkoutTitle"
            android:layout_marginTop="6dp"
            android:text="Workout subtitle"
            android:textColor="@color/dark_blue2"
            android:textSize="12sp"
            android:fontFamily="@font/allerta_stencil" />

        <TextView
            android:id="@+id/buttonRemoveWorkout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Remove"
            android:textColor="@color/yellow"
            android:textSize="12sp"
            android:fontFamily="@font/allerta_stencil"
            android:padding="6dp"
            android:background="@drawable/card_light_grey" />

        <TextView
            android:id="@+id/textDragHandle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="8dp"
            android:text="≡"
            android:textColor="@color/dark_blue2"
            android:textSize="18sp" />
    </RelativeLayout>
</FrameLayout>
