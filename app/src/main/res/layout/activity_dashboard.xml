<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_bg">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/imageviewBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_dark_geometric"
        android:scaleType="centerCrop"
        android:alpha="0.28"
        android:contentDescription="@string/background_desc" />

    <!-- Scrollable content so layout adapts to small screens -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Top row: greeting + logout -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/textviewGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/greeting_text"
                    android:textColor="@color/white"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/allerta_stencil"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="yes"
                    android:accessibilityLiveRegion="polite"/>

                <TextView
                    android:id="@+id/textviewLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/logout"
                    android:textColor="@color/yellow"
                    android:textSize="14sp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/allerta_stencil"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/logout" />
            </RelativeLayout>

            <!-- Subheading -->
            <TextView
                android:id="@+id/textviewSubheading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ready_to_train"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/allerta_stencil" />

            <!-- Workouts container -->
            <LinearLayout
                android:id="@+id/layoutWorkouts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <!-- Card style helper: use background drawable with padding and elevation if available -->
                <RelativeLayout
                    android:id="@+id/cardUpperBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/imageviewUpperBody"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:src="@drawable/ic_upper_body"
                        android:scaleType="centerCrop"
                        android:layout_alignParentStart="true"
                        android:contentDescription="@string/upper_body_desc" />

                    <TextView
                        android:id="@+id/textviewUpperBodyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upper_body"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="22sp"
                        android:layout_toEndOf="@id/imageviewUpperBody"
                        android:layout_marginStart="12dp"
                        android:layout_alignTop="@id/imageviewUpperBody"
                        android:fontFamily="@font/allerta_stencil" />

                    <TextView
                        android:id="@+id/textviewUpperBodyDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upper_body_details"
                        android:textColor="@color/dark_blue2"
                        android:textSize="12sp"
                        android:layout_below="@id/textviewUpperBodyTitle"
                        android:layout_toEndOf="@id/imageviewUpperBody"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/allerta_stencil" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/cardLowerBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/imageviewLowerBody"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:src="@drawable/ic_lower_body"
                        android:scaleType="centerCrop"
                        android:layout_alignParentStart="true"
                        android:contentDescription="@string/lower_body_desc" />

                    <TextView
                        android:id="@+id/textviewLowerBodyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lower_body"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="22sp"
                        android:layout_toEndOf="@id/imageviewLowerBody"
                        android:layout_marginStart="12dp"
                        android:layout_alignTop="@id/imageviewLowerBody"
                        android:fontFamily="@font/allerta_stencil" />

                    <TextView
                        android:id="@+id/textviewLowerBodyDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lower_body_details"
                        android:textColor="@color/dark_blue2"
                        android:textSize="12sp"
                        android:layout_below="@id/textviewLowerBodyTitle"
                        android:layout_toEndOf="@id/imageviewLowerBody"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/allerta_stencil" />
                </RelativeLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Centered global ProgressBar (hidden by default) -->
    <ProgressBar
        android:id="@+id/progressBarGlobal"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:visibility="gone"
        android:contentDescription="@string/loading" />

    <!-- Bottom Navigation (fixed) -->
    <LinearLayout
        android:id="@+id/layoutBottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:background="@color/dark_blue"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/iconHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_home"
            android:contentDescription="@string/home_desc"
            android:scaleY=".75"
            android:scaleX=".75"
            android:layout_gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <ImageView
            android:id="@+id/iconWorkouts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_dumbbell"
            android:contentDescription="@string/workouts_desc"
            android:scaleY=".75"
            android:scaleX=".75"
            android:layout_gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <ImageView
            android:id="@+id/iconPlans"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_clipboard"
            android:contentDescription="@string/plans_desc"
            android:scaleY=".75"
            android:scaleX=".75"
            android:layout_gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <ImageView
            android:id="@+id/iconProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_user"
            android:contentDescription="@string/profile_desc"
            android:scaleY=".75"
            android:scaleX=".75"
            android:layout_gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
</RelativeLayout>
