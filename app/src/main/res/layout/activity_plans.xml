<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/plansRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_bg">

    <ImageView
        android:id="@+id/imageviewBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_dark_geometric"
        android:scaleType="centerCrop"
        android:alpha="0.28"
        android:contentDescription="@string/background_desc" />

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layoutBottomNav"
        android:fillViewport="true"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/textviewPlansHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Plans"
                android:textColor="@color/white"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="@font/allerta_stencil"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textviewPlansSubheading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Organize your workouts into reusable routines"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/allerta_stencil" />

            <TextView
                android:id="@+id/textviewPlansSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create plans, open them, and start guided sessions."
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginBottom="18dp"
                android:fontFamily="@font/allerta_stencil" />

            <TextView
                android:id="@+id/buttonCreatePlan"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/card_yellow"
                android:gravity="center"
                android:text="Create Plan"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="16sp"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPlans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingBottom="80dp" />

            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="24dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_light_grey">

                <TextView
                    android:id="@+id/textEmptyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No plans yet"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/allerta_stencil" />

                <TextView
                    android:id="@+id/textEmptyBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Create your first plan and add workouts to make a routine."
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/allerta_stencil" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBarLoading"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:visibility="gone"
        android:contentDescription="@string/loading" />

    <LinearLayout
        android:id="@+id/layoutBottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:background="@color/dark_blue"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/iconHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_home"
            android:contentDescription="@string/home_desc"
            android:scaleY=".75"
            android:scaleX=".75"
            android:layout_gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/iconWorkouts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_dumbbell"
            android:contentDescription="@string/workouts_desc"
            android:scaleY=".75"
            android:scaleX=".75"
            android:layout_gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/iconPlans"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_clipboard"
            android:contentDescription="@string/plans_desc"
            android:scaleY=".75"
            android:scaleX=".75"
            android:layout_gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/iconProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_user"
            android:contentDescription="@string/profile_desc"
            android:scaleY=".75"
            android:scaleX=".75"
            android:layout_gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</RelativeLayout>
